# QuizNova Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# =============================================================================
# Flask Core
# =============================================================================
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# =============================================================================
# Database
# =============================================================================
# Format: mysql+pymysql://user:password@host/database
DATABASE_URL=mysql+pymysql://root:@localhost/quiznova

# =============================================================================
# File Uploads
# =============================================================================
UPLOAD_MAX_MB=2

# =============================================================================
# Quiz Configuration
# =============================================================================
MAX_VIOLATIONS=3
CERTIFICATE_PASS_THRESHOLD=60
CERTIFICATE_ENABLED=1

# =============================================================================
# Site URL (used for QR code links and certificate verification URLs)
# =============================================================================
SITE_URL=http://localhost:5000

# =============================================================================
# Email Service (optional — leave blank to disable email features)
# =============================================================================
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@quiznova.com

# =============================================================================
# Cloudinary CDN (optional — leave blank to use local file storage)
# =============================================================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# AI APIs (optional — v2 feature, stubs only in v1)
# =============================================================================
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# OAuth 2.0 Credentials (Google & GitHub)
# =============================================================================
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://quiz-nova-nu.vercel.app/auth/google/callback

# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=https://quiz-nova-nu.vercel.app/auth/github/callback

